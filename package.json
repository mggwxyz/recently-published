    "@types/object-hash": "^3.0.6",
    "@types/react": "^18.3.21",
    "@types/semver": "^7.7.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "@typescript-eslint/parser": "^8.32.1",
    "esbuild": "^0.25.4",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.4.0",
    "execa": "^9.5.3",
    "p-wait-for": "^5.0.2",
    "prettier": "3.3.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "~5.7.3",
