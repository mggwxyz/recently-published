{
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["vitest/globals", "node"],
    "lib": ["ES2015", "DOM"]
  }
}
